# ==============================================================================
# FINN Personal Finance Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local before running in development/production.
# IMPORTANT: Never commit production secret keys, service-role tokens, or
# private credentials to version control.
# ==============================================================================

# Application Environment & Core Settings
VITE_APP_ENV=development
VITE_APP_NAME="FINN Financial Intelligence"
VITE_DEFAULT_CURRENCY=INR
VITE_LOCALE=en-IN
VITE_APP_URL=http://localhost:5173

# Supabase / PostgreSQL Persistence (Production Backend)
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Note: SUPABASE_SERVICE_ROLE_KEY must strictly be kept on server-side functions / edge workers!
# SUPABASE_SERVICE_ROLE_KEY=eyJh...

# Reserve Bank of India (RBI) Account Aggregator (AA) Integration
# Sandbox or Production credentials for licensed NBFC-AA gateways (e.g. Setu, Finvu, OneMoney)
VITE_AA_GATEWAY_URL=https://api.sandbox.setu.co/v1/aa
VITE_AA_CLIENT_ID=your-aa-client-id
VITE_AA_CLIENT_SECRET=your-aa-client-secret
VITE_AA_WEBHOOK_SECRET=your-aa-webhook-signing-secret

# Foreign Exchange Rate Live Feeds
# Open Exchange Rates / Fixer.io / Frankfurter API
VITE_EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key
VITE_EXCHANGE_RATE_BASE_URL=https://api.exchangerate-api.com/v4/latest

# AI Financial Context & Reasoning Integration (Gemini / Claude / OpenAI)
# Used by contextual financial intelligence engine
VITE_AI_PROVIDER=gemini
VITE_AI_API_KEY=your-gemini-or-claude-api-key
VITE_AI_MODEL=gemini-1.5-pro

# Security & Encryption Salts
# Used for client-side sensitive memo obscuration and session signing
VITE_CLIENT_CRYPTO_SALT=your-high-entropy-client-salt-32-chars
